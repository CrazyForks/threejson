    {
      "name": "threebox-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "apps/threebox"
      ],
      "port": 5182
    },
    {
      "name": "scene-editor-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "apps/scene-editor"
