{
  "_doc": "Reference schema for ThreeJSON AI-related settings. Chat planning and the independent texture acquisition service use separate provider configuration.",
  "llm": {
    "provider": "chatgpt",
    "apiKey": "",
    "baseUrl": "",
    "model": "",
    "temperature": 0.2,
    "maxTokens": 4000
  },
  "agent": {
    "enabled": false,
    "depth": "medium"
  },
  "texture": {
    "fillAfterAgent": false,
    "baseUrl": "",
    "apiKey": "",
    "strategy": "semantic-hybrid",
    "pbr": true,
    "allowUnknownLicense": false,
    "persistenceMode": "remote",
    "concurrency": 3
  },
  "asset": {
    "mode": "crawl",
    "searchApiKey": "",
    "searchEngine": "bing",
    "unsplashAccessKey": "",
    "allowlistDomains": [],
    "respectRobots": true,
    "maxConcurrent": 4,
    "htmlSearchTemplate": "https://duckduckgo.com/?q={query}&iax=images&ia=images"
  },
  "paths": {
    "_doc": "Agent runtime uses relativetRoot + redirectRelative (see tools/threejson-agent/setting.example.json). Example below is schema reference only.",
    "relativetRoot": "../..",
    "redirectRelative": false,
    "redirectRelativeWarn": true
  }
}
